# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.
# Based on Immich v3.4.2 example.env:
#   https://github.com/immich-app/immich/releases/latest/download/example.env
# All supported variables: https://docs.immich.app/install/environment-variables

# --- Media storage -----------------------------------------------------------
# Where photos/videos are stored on the host.
#   Running `docker compose` from Windows PowerShell:  D:/Gallery   (forward slashes)
#   Running `docker compose` from inside WSL 2:         /mnt/d/Gallery
# Immich owns this folder's layout. Never add/move/rename files in it by hand.
UPLOAD_LOCATION=D:/Gallery

# --- Database storage --------------------------------------------------------
# Intentionally NOT set. Postgres uses the Docker named volume `pgdata`
# (see docker-compose.yml). Do not point the DB at an NTFS path.

# --- Timezone ----------------------------------------------------------------
# Replaces the /etc/localtime mount (which doesn't exist on Windows).
# TZ identifiers: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Etc/UTC

# --- Immich version ----------------------------------------------------------
# Pinned to an exact release so updates only happen when you choose
# (scripts/update.ps1). Upstream default is the floating major tag "v3".
IMMICH_VERSION=v3.4.2

# --- Database credentials ----------------------------------------------------
# Use only A-Za-z0-9 (no special characters or spaces).
# scripts/setup-windows.ps1 generates a random one for you.
DB_PASSWORD=change-me

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Phase 2 / automation (not read by Immich) -------------------------------
# Used by scripts/memories.py and the custom frontend. Create the key in
# Immich web UI → Account Settings → API Keys.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=
