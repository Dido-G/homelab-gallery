# Normalise line endings so the repo works whether cloned on Windows or in WSL.
* text=auto eol=lf

# PowerShell scripts are friendlier with CRLF on Windows
*.ps1 text eol=crlf

# Compose/env files must stay LF (read by Linux containers / docker compose)
*.yml   text eol=lf
*.yaml  text eol=lf
.env*   text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
